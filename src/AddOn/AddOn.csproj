<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{1336EF9E-AA11-4807-AE23-54F70E7D6D66}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>MyAddOn</RootNamespace>
    <!-- scripts\build.ps1 passes these from project.psd1 and -Version. The defaults are for building in Visual Studio. -->
    <AddOnName Condition=" '$(AddOnName)' == '' ">AddOn</AddOnName>
    <AddOnFriendlyName Condition=" '$(AddOnFriendlyName)' == '' ">$(AddOnName)</AddOnFriendlyName>
    <AddOnTitle Condition=" '$(AddOnTitle)' == '' ">$(AddOnName)</AddOnTitle>
    <AddOnPublisher Condition=" '$(AddOnPublisher)' == '' ">Unknown</AddOnPublisher>
    <AddOnVersion Condition=" '$(AddOnVersion)' == '' ">0.0.0</AddOnVersion>
    <AssemblyName>$(AddOnName)</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- Alibre's "Program" folder. scripts\build.ps1 passes it; for Visual Studio, set the ALIBRE_SDK_DIR environment variable. -->
    <AlibreSdkDir Condition=" '$(AlibreSdkDir)' == '' ">$(ALIBRE_SDK_DIR)</AlibreSdkDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Windows.Forms" />
    <!-- These load from Alibre's own Program folder at run time, so they aren't copied. -->
    <Reference Include="AlibreX">
      <HintPath>$(AlibreSdkDir)\AlibreX.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="AlibreAddOn">
      <HintPath>$(AlibreSdkDir)\AlibreAddOn.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AddOnEntry.cs" />
    <Compile Include="AddOnInterface.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- The DLL's properties come from one place: project.psd1, by way of scripts\build.ps1. -->
  <Target Name="WriteVersionInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <VersionAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(AddOnVersion).0</_Parameter1>
      </VersionAttribute>
      <VersionAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(AddOnVersion).0</_Parameter1>
      </VersionAttribute>
      <VersionAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(AddOnVersion)</_Parameter1>
      </VersionAttribute>
      <VersionAttribute Include="System.Reflection.AssemblyTitleAttribute">
        <_Parameter1>$(AddOnFriendlyName)</_Parameter1>
      </VersionAttribute>
      <VersionAttribute Include="System.Reflection.AssemblyProductAttribute">
        <_Parameter1>$(AddOnTitle)</_Parameter1>
      </VersionAttribute>
      <VersionAttribute Include="System.Reflection.AssemblyCompanyAttribute">
        <_Parameter1>$(AddOnPublisher)</_Parameter1>
      </VersionAttribute>
      <VersionAttribute Include="System.Reflection.AssemblyCopyrightAttribute">
        <_Parameter1>$(AddOnCopyright)</_Parameter1>
      </VersionAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" AssemblyAttributes="@(VersionAttribute)" OutputFile="$(IntermediateOutputPath)VersionInfo.cs">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>
  <Target Name="CheckAlibreSdkDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(AlibreSdkDir)\AlibreX.dll')">
    <Error Text="AlibreX.dll wasn't found. Run scripts\build.ps1, or set ALIBRE_SDK_DIR to Alibre's Program folder." />
  </Target>
</Project>
